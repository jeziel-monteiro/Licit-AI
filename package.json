{
  "name": "licitai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13.0 <23 || >=24" },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "smoke": "node scripts/smoke.mjs",
    "test": "node --import tsx --test --experimental-test-isolation=none tests/*.test.ts",
    "import:pncp": "node --env-file-if-exists=.env --import tsx scripts/import-pncp.ts",
    "import:file": "node --env-file-if-exists=.env --import tsx scripts/import-file.ts",
    "demo": "node --env-file-if-exists=.env --import tsx scripts/import-file.ts data/pncp-sample.json",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "tailwindcss": "4.3.5",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "tsx": "^4.21.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": { "minimatch": "^11.0.1" }
  }
}
