# Banco local. O diretório é criado automaticamente.
DATABASE_PATH=./data/licitai.sqlite
# Limites padrão do importador; também configuráveis pela linha de comando.
PNCP_TIMEOUT_MS=15000
PNCP_RETRIES=2
PNCP_PAGE_SIZE=50
PNCP_MAX_PAGES=2
PNCP_MAX_RECORDS=100
PNCP_UF=SP
PNCP_MODALITY=6

# IA: use uma chave da API OpenAI somente no servidor, sem prefixo NEXT_PUBLIC_.
# Sem chave, a aplicação mostra "IA não configurada" e não faz chamadas.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_TIMEOUT_MS=20000
OPENAI_DEADLINE_MS=45000
OPENAI_MAX_RETRIES=1
OPENAI_MAX_INPUT_BYTES=24000
OPENAI_MAX_OUTPUT_TOKENS=4000
